  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "o1p2q3r4",
   "metadata": {},
   "outputs": [],
   "source": [
    "calibrator.add_calibration_point(\n",
    "    pixel_coord=(130, 290),\n",
    "    robot_coord=(-21.8, -197.4),\n",
    "    label=\"左下角\"\n",
    ")\n",
    "\n",
    "calibrator.add_calibration_point(\n",
    "    pixel_coord=(640, 0),\n",
    "    robot_coord=(215.0, -59.1),\n",
    "    label=\"右上角\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "s5t6u7v8",
   "metadata": {},
   "source": [

   "source": [
    "### 4.2 实际使用时的代码模板\n",
    "\n",
    "在实际项目中，可以使用以下代码模板："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "g7h8i9j0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class VisionArmController:\n",
    "    \"\"\"视觉-机械臂控制器示例\"\"\"\n",
    "    \n",
    "    def __init__(self, calibration_file: str = None):\n",
    "        self.calibrator = Calibrator()\n",
    "        \n",
    "        if calibration_file and os.path.exists(calibration_file):\n",
    "            self.calibrator.load_calibration(calibration_file)\n",
    "    \n",
    "    def pixel_to_robot(self, px: int, py: int) -> tuple:\n",
    "        \"\"\"像素坐标转机械臂坐标\"\"\"\n",
    "        return self.calibrator.pixel_to_robot(px, py)\n",
    "    \n",
    "    def add_calibration_point(self, pixel: tuple, robot: tuple, label: str = \"\"):\n",
    "        \"\"\"添加标定点\"\"\"\n",
    "        self.calibrator.add_calibration_point(pixel, robot, label)\n",
    "    \n",
    "    def perform_calibration(self) -> dict:\n",
    "        \"\"\"执行标定并返回误差信息\"\"\"\n",
    "        success = self.calibrator.calculate_linear_transform()\n",
    "        if not success:\n",
    "            return {\"success\": False, \"error\": \"标定计算失败\"}\n",
    "        \n",
    "        errors = self.calibrator.evaluate_errors()\n",
    "        return {\"success\": True, **errors}\n",
    "    \n",
    "    def save_calibration(self, filepath: str):\n",
    "        \"\"\"保存标定数据\"\"\"\n",
    "        return self.calibrator.save_calibration(filepath)\n",
    "    \n",
    "    def get_calibration_info(self) -> str:\n",
    "        \"\"\"获取标定信息\"\"\"\n",
    "        return self.calibrator.get_calibration_info()\n",
    "\n",
    "\n",
    "print(\"控制器模板已定义，可以在实际项目中使用\")"
   ]
  },
  {

   "source": [
    "## 第四部分：与机械臂结合的完整流程\n",
    "\n",
    "### 4.1 完整标定流程示例\n",
    "\n",
    "以下是实际使用时的完整流程："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "y9z0a1b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def complete_calibration_workflow():\n",
    "    print(\"=\" * 60)\n",
    "    print(\"完整标定流程\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    calibrator = Calibrator()\n",
    "    \n",
    "    print(\"\\n[步骤1] 准备标定点\")\n",
    "    print(\"  - 在工作区域放置至少2个标记点\")\n",
    "    print(\"  - 使用相机工具获取每个标记点的像素坐标\")\n",
    "    print(\"  - 控制机械臂移动到每个标记点，记录机械臂坐标\")\n",
    "    \n",
    "    print(\"\\n[步骤2] 添加标定点 (示例)\")\n",
    "    calibration_points_data = [\n",
    "        {(130, 290): (-21.8, -197.4), \"label\": \"左下角\"},\n",
    "        {(640, 0): (215.0, -59.1), \"label\": \"右上角\"},\n",
    "    ]\n",
    "    \n",
    "    calibrator.add_calibration_point((130, 290), (-21.8, -197.4), \"左下角\")\n",
    "    calibrator.add_calibration_point((640, 0), (215.0, -59.1), \"右上角\")\n",
    "    \n",
    "    print(f\"  已添加 {len(calibrator.get_points())} 个标定点\")\n",
    "    \n",
    "    print(\"\\n[步骤3] 执行标定计算\")\n",
    "    success = calibrator.calculate_linear_transform()\n",
    "    print(f\"  标定计算: {'成功' if success else '失败'}\")\n",
    "    \n",
    "    print(\"\\n[步骤4] 误差评估\")\n",
    "    errors = calibrator.evaluate_errors()\n",
    "    print(f\"  平均误差: {errors['mean_error']:.2f} mm\")\n",
    "    print(f\"  最大误差: {errors['max_error']:.2f} mm\")\n",
    "    \n",
    "    print(\"\\n[步骤5] 保存标定数据\")\n",
    "    calibrator.save_calibration(\"calibration_final.json\")\n",
    "    \n",
    "    print(\"\\n[步骤6] 使用标定结果\")\n",
    "    test_pixel = (320, 240)\n",
    "    robot_x, robot_y = calibrator.pixel_to_robot(test_pixel[0], test_pixel[1])\n",
    "    print(f\"  像素坐标 {test_pixel} -> 机械臂坐标 ({robot_x:.1f}, {robot_y:.1f})\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"标定流程完成！\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    return calibrator\n",
    "\n",
    "calibrator = complete_calibration_workflow()"
   ]
  },
